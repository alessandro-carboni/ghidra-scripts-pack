<Window x:Class="GhidraTriage.Gui.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" xmlns:conv="clr-namespace:GhidraTriage.Gui.App.Converters" Title="Seeded Graph Explorer" Width="1500" Height="930" MinWidth="1100" MinHeight="700" Background="{StaticResource BackgroundBrush}" WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="OnDrop" PreviewKeyDown="OnKey">
<Window.Resources><conv:NonEmptyVisibilityConverter x:Key="NonEmpty"/></Window.Resources><Window.InputBindings><KeyBinding Key="R" Modifiers="Control" Command="{Binding AnalyzeCommand}"/><KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenDatasetCommand}"/><KeyBinding Key="Escape" Command="{Binding ClearSelectionCommand}"/></Window.InputBindings>
<Grid><Grid.RowDefinitions><RowDefinition Height="110"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="36"/></Grid.RowDefinitions>
<Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="22,14"><DockPanel>
<StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Open dataset" Command="{Binding OpenDatasetCommand}" ToolTip="Open manifest.json · Ctrl+O"/><Button Content="Select sample" Command="{Binding SelectSampleCommand}" ToolTip="Choose an executable sample"/><Button Content="Analyze" Command="{Binding AnalyzeCommand}" ToolTip="Run backend pipeline · Ctrl+R"/><Button Content="Dataset folder" Command="{Binding OpenFolderCommand}"/></StackPanel>
<StackPanel><TextBlock Text="SEEDED / GRAPH EXPLORER" Foreground="{StaticResource AccentBrush}" FontSize="11"/><TextBlock Text="{Binding Sample}" FontSize="24" FontWeight="SemiBold" Margin="0,3"/><TextBlock Text="{Binding Versions}" Foreground="{StaticResource MutedBrush}" FontSize="11"/></StackPanel>
</DockPanel></Border>
<StackPanel Grid.Row="1"><TextBlock Text="{Binding Error}" Visibility="{Binding Error,Converter={StaticResource NonEmpty}}" Foreground="#FFA7A7" TextWrapping="Wrap" Margin="20,3"/><TextBlock Text="{Binding Warning}" Visibility="{Binding Warning,Converter={StaticResource NonEmpty}}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" MaxHeight="95" Margin="20,0"/><ProgressBar Height="2" IsIndeterminate="{Binding IsBusy}" Foreground="{StaticResource AccentBrush}" Background="{StaticResource BackgroundBrush}"/></StackPanel>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition x:Name="LeftColumn" Width="290" MinWidth="230"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*" MinWidth="360"/><ColumnDefinition Width="5"/><ColumnDefinition x:Name="RightColumn" Width="310" MinWidth="230"/></Grid.ColumnDefinitions>
<Border Background="{StaticResource PanelBrush}" Padding="16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="DATASET" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,0,0,10"/><TextBlock Text="{Binding SamplePath}" TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource MutedBrush}" MaxHeight="30"/><Button Content="Full typed graph" Command="{Binding FullGraphCommand}" Margin="0,6,0,12"/></StackPanel>
<StackPanel Grid.Row="1"><TextBlock Text="OBSERVABLE SEEDS" Style="{StaticResource SectionTitle}"/><TextBox Text="{Binding SeedSearch,UpdateSourceTrigger=PropertyChanged}" ToolTip="Search seed ID, anchor or trigger"/><ComboBox ItemsSource="{Binding Families}" SelectedItem="{Binding SelectedFamily}" Margin="0,0,0,7"/><WrapPanel><CheckBox Content="Grouped" IsChecked="{Binding GroupedOnly}" Margin="0,0,10,5"/><Button Content="Reset" Command="{Binding ResetSeedFiltersCommand}" Padding="7,3"/><Button Content="Group members" Command="{Binding RelatedGroupCommand}" Padding="7,3"/></WrapPanel><TextBlock Text="{Binding SeedCount}" Foreground="{StaticResource MutedBrush}" Margin="0,7"/></StackPanel>
<ListBox Grid.Row="2" ItemsSource="{Binding Seeds}" SelectedItem="{Binding SelectedSeed}" ScrollViewer.CanContentScroll="True"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Anchor}" FontWeight="SemiBold"/><TextBlock Text="{Binding Families}" Foreground="{StaticResource AccentBrush}" FontSize="11" Margin="0,3"/><TextBlock Text="{Binding Triggers}" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{StaticResource MutedBrush}" ToolTip="{Binding Triggers}"/><TextBlock Text="{Binding Summary}" FontSize="11" Margin="0,4"/><TextBlock Text="{Binding Id}" FontSize="10" Foreground="{StaticResource MutedBrush}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
</Grid></Border>
<GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{StaticResource BorderBrush}"/>
<Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
<StackPanel Margin="14,10"><TextBlock Text="{Binding Breadcrumb}" FontWeight="SemiBold" Margin="0,0,0,4"/><TextBlock Text="{Binding GraphSummary}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/><WrapPanel><Button Content="Fit" Command="{Binding FitCommand}" ToolTip="Fit visible graph · F"/><Button Content="Radial" Command="{Binding LayoutCommand}" CommandParameter="concentric"/><Button Content="Force" Command="{Binding LayoutCommand}" CommandParameter="cose"/><Button Content="Grid" Command="{Binding LayoutCommand}" CommandParameter="grid"/><Button Content="Labels" Command="{Binding LabelsCommand}" CommandParameter="all"/><Button Content="Auto labels" Command="{Binding LabelsCommand}" CommandParameter="progressive"/></WrapPanel></StackPanel>
<Grid Grid.Row="1" Margin="14,0,14,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="NodeSearchBox" Text="{Binding NodeSearch,UpdateSourceTrigger=PropertyChanged}" ToolTip="Search node ID, name or value · Ctrl+F" Margin="0,0,8,0"><TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SearchCommand}"/></TextBox.InputBindings></TextBox><Button Grid.Column="1" Content="Find" Command="{Binding SearchCommand}"/></Grid>
<wv:WebView2 x:Name="GraphHost" Grid.Row="2" DefaultBackgroundColor="#101722"/>
</Grid>
<GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="{StaticResource BorderBrush}"/>
<Border Grid.Column="4" Background="{StaticResource PanelBrush}" Padding="16"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
<Expander Header="Analysis &amp; settings" Foreground="{StaticResource TextBrush}" Margin="0,0,0,14"><StackPanel><TextBlock Text="{Binding RunStatus}" Margin="0,8"/><Button Content="Cancel analysis" Command="{Binding CancelAnalysisCommand}" IsEnabled="{Binding IsAnalyzing}"/><TextBox Text="{Binding LiveLog,Mode=OneWay}" IsReadOnly="True" Height="130" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" FontSize="10" Margin="0,8"/><TextBlock Text="Triage executable"/><TextBox Text="{Binding TriageExecutable,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Ghidra directory"/><TextBox Text="{Binding GhidraDirectory,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Rule directory"/><TextBox Text="{Binding RuleDirectory,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Rust executable"/><TextBox Text="{Binding RustExecutable,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Reports directory"/><TextBox Text="{Binding OutputRoot,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Repository directory"/><TextBox Text="{Binding WorkingDirectory,UpdateSourceTrigger=PropertyChanged}"/><Button Content="Save settings" Command="{Binding SaveSettingsCommand}"/></StackPanel></Expander><TextBlock Text="INSPECTOR" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding InspectorTitle}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding InspectorId}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6"/>
<WrapPanel Margin="0,4,0,10"><Button Content="Copy ID" Command="{Binding CopyIdCommand}" Padding="7,5"/><Button Content="Copy JSON" Command="{Binding CopyDetailsCommand}" Padding="7,5"/><Button Content="Unresolved" Command="{Binding UnresolvedCommand}" Padding="7,5"/></WrapPanel>
<WrapPanel><Button Content="Focus source / caller" Command="{Binding FocusCommand}" CommandParameter="{Binding SourceId}" Padding="6,4" ToolTip="{Binding SourceId}"/><Button Content="Focus target" Command="{Binding FocusCommand}" CommandParameter="{Binding TargetId}" Padding="6,4" ToolTip="{Binding TargetId}"/></WrapPanel>
<ItemsControl ItemsSource="{Binding Fields}" Margin="0,12"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,8"><TextBlock Text="{Binding Name}" Foreground="{StaticResource AccentBrush}" FontSize="11"/><TextBox Text="{Binding Value,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0,3" MaxHeight="110" VerticalScrollBarVisibility="Auto"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
<Expander Header="Source JSON / context" Foreground="{StaticResource TextBrush}" Margin="0,6"><TextBox Text="{Binding Details,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" MaxHeight="260" VerticalScrollBarVisibility="Auto"/></Expander>
<Expander Header="Filters &amp; legend" Foreground="{StaticResource TextBrush}" IsExpanded="True" Margin="0,12"><StackPanel Margin="0,10"><TextBlock Text="NODE TYPES" Style="{StaticResource SectionTitle}"/><ItemsControl ItemsSource="{Binding NodeTypes}"><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding Enabled}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="EDGE TYPES" Style="{StaticResource SectionTitle}" Margin="0,12,0,4"/><ItemsControl ItemsSource="{Binding EdgeTypes}"><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding Enabled}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><CheckBox Content="Trigger evidence + anchor" IsChecked="{Binding TriggerOnly}" IsEnabled="{Binding IsLocal}"/><CheckBox Content="Anchor neighborhood" IsChecked="{Binding AnchorNeighborhood}" IsEnabled="{Binding IsLocal}"/><TextBlock Text="Local role" FontSize="11"/><ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding Role}" IsEnabled="{Binding IsLocal}"/><TextBlock Text="◎ Anchor ring · ◆ Trigger border" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,8"/><Button Content="Reset filters" Command="{Binding ResetFiltersCommand}" Margin="0,5"/></StackPanel></Expander>
<Expander Header="Search results" Foreground="{StaticResource TextBrush}"><ItemsControl ItemsSource="{Binding SearchResults}"><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding}" Command="{Binding DataContext.FocusCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="0,3" Padding="6"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander>
<TextBlock Text="EXPORT" Style="{StaticResource SectionTitle}" Margin="0,18,0,8"/><WrapPanel><Button Content="PNG 2×" Command="{Binding ExportPngCommand}" Padding="8,5"/><Button Content="DOT" Command="{Binding ExportDotCommand}" CommandParameter="all" Padding="8,5"/><Button Content="Visible DOT" Command="{Binding ExportDotCommand}" CommandParameter="visible" Padding="8,5"/></WrapPanel><Button Content="Open source JSON" Command="{Binding OpenJsonCommand}" Margin="0,8,0,0"/>
</StackPanel></ScrollViewer></Border></Grid>
<Border Grid.Row="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,8"><TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}"/></Border>
</Grid></Window>



